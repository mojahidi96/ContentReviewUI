# Mock ContentReviewService settings (development only). Copy to `.env` to override defaults.
# The mock mirrors the real Node API (docs/api-contract.md); to use the real service instead,
# run it on :3000 and start the UI with `npm start`.
# No secrets belong here — the Angular app has no secrets at all.
PORT=3000
HOST=localhost
MOCK_LATENCY_MS=300
MOCK_REVIEW_LATENCY_MS=1200
# Probability (0..1) that a review ends in review.failed (LLM_SERVICE_UNAVAILABLE) — use 1 to demo
# the failure/retry UI.
MOCK_REVIEW_FAILURE_RATE=0
# Shorten (e.g. 60000) to demo session-expiry handling. Default matches Node's 15 minutes.
MOCK_SESSION_TTL_MS=900000
# Set to true to mark cookies Secure (needs https or a browser that allows it on localhost).
COOKIE_SECURE=false
