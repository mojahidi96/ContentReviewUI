# Mock ContentReviewService settings (development only). Copy to `.env` to override defaults.
# No secrets belong here — the Angular app has no secrets at all.
PORT=3000
HOST=localhost
MOCK_LATENCY_MS=300
MOCK_REVIEW_LATENCY_MS=1200
# Probability (0..1) that POST /reviews fails with 503 — use 1 to demo the error/retry UI.
MOCK_REVIEW_FAILURE_RATE=0
# Shorten (e.g. 60000) to demo session-expiry handling.
MOCK_SESSION_TTL_MS=1800000
